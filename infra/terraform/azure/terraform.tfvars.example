# AiSOC — Azure serverless skeleton
#
# Copy this file to `terraform.tfvars` and override what you need. Every
# variable has a sensible default for a startup-credit-friendly demo, so an
# empty `terraform.tfvars` already produces a working stack. Authentication is
# picked up from `az login` (or ARM_* env vars), not from this file.

# ─── Subscription / location ─────────────────────────────────────────────────

# subscription_id = "00000000-0000-0000-0000-000000000000"  # or use ARM_SUBSCRIPTION_ID
# location        = "eastus"
# workload_location = "northeurope" # optional when a service is restricted in the RG region
# name_prefix     = "aisoc"   # 3-12 lowercase chars; keeps ACR + Key Vault names valid

# Existing Microsoft Sentinel workspace (same Entra tenant as this deployment).
sentinel_rg_name = "replace-with-sentinel-resource-group"
sentinel_workspace_name = "replace-with-sentinel-workspace-name"
# sentinel_subscription_id = "00000000-0000-0000-0000-000000000000" # empty uses current subscription

# tags = {
#   project    = "aisoc"
#   managed_by = "terraform"
#   env        = "demo"
# }

# ─── Networking ──────────────────────────────────────────────────────────────

# vnet_cidr               = "10.20.0.0/16"
# aca_subnet_cidr         = "10.20.0.0/23"   # Container Apps needs at least /23
# postgres_subnet_cidr    = "10.20.2.0/27"   # delegated to Postgres Flexible Server
# privatelink_subnet_cidr = "10.20.3.0/27"   # Redis (+ future) private endpoints
# clickhouse_subnet_cidr  = "10.30.0.0/27"  # single interruptible PoC node
# clickhouse_vnet_cidr    = "10.30.0.0/16"  # peered cross-region lake VNet

# ─── ClickHouse proof-of-concept lake ───────────────────────────────────────

# ClickHouse Cloud Basic cannot be combined with a customer-selected Spot VM.
# This stack therefore deploys a Basic-sized self-hosted PoC footprint.
# D4as_v5 is preferred where permitted. The current North Europe test
# subscription exposes the equivalent DC4as_v6 Spot SKU instead.
# clickhouse_location          = "germanywestcentral"
# clickhouse_vm_size           = "Standard_E2as_v5"
# clickhouse_data_disk_size_gb = 512
# poc_tenant_id                  = "00000000-0000-0000-0000-000000000001"
# clickhouse_image             = "clickhouse/clickhouse-server:25.8-alpine"

# ─── PostgreSQL Flexible Server ──────────────────────────────────────────────

# postgres_sku        = "GP_Standard_D2s_v3"  # B_Standard_B1ms for a cheap sandbox
# postgres_version    = "16"
# postgres_storage_mb = 32768
# postgres_db_name    = "aisoc"
# postgres_user       = "aisoc"
# postgres_zone       = "1"

# ─── Azure Managed Redis ─────────────────────────────────────────────────────

# managed_redis_sku                       = "Balanced_B0"
# managed_redis_high_availability_enabled = true # false only for a test deployment

# ─── Azure Event Hubs ────────────────────────────────────────────────────────

# Standard supports 1-7 days. Seven days gives operators a practical replay
# window; retained volume beyond the tier's included allowance can add storage
# charges. This applies uniformly to every AiSOC Event Hub.
# eventhub_message_retention_days = 7

# ─── Container Apps images ───────────────────────────────────────────────────
#
# Defaults point at the public GHCR demo images so the skeleton runs with zero
# CI work. Override with images you've pushed to the ACR this stack provisions.

# api_image    = "ghcr.io/beenuar/aisoc-core-api:latest"
# web_image    = "ghcr.io/beenuar/aisoc-web:latest"
# ingest_image = "ghcr.io/beenuar/aisoc-ingest:latest"
# connectors_image = "ghcr.io/beenuar/aisoc-connectors:latest"
# actions_image    = "ghcr.io/beenuar/aisoc-actions:latest"
# fusion_image     = "ghcr.io/beenuar/aisoc-fusion:latest"
# agents_image     = "ghcr.io/beenuar/aisoc-agents:latest"
# realtime_image   = "ghcr.io/beenuar/aisoc-realtime:latest"
# model_gateway_image = "your-registry.example/aisoc-model-gateway@sha256:<digest>"

# ─── Container Apps scaling ──────────────────────────────────────────────────

# api_min_replicas    = 0   # >0 to avoid cold starts
# api_max_replicas    = 10
# web_max_replicas    = 5
# ingest_max_replicas = 5

# ─── Access ──────────────────────────────────────────────────────────────────

# cors_origins = "https://app.example.com,https://demo.example.com"
# operations_email = "soc-operations@example.com"

# ─── Managed-identity AI model plane ─────────────────────────────────────────
#
# The model gateway uses the pipeline user-assigned identity to call the
# private Foundry account. GPT-5.6-Terra is always deployed. Claude remains
# disabled until Microsoft has allowlisted the subscription for that
# Marketplace offer; once allowlisted, the attestation values below must be
# legally accurate.

# ai_location        = "swedencentral"
# gpt_terra_capacity = 10

# enable_claude_sonnet     = false
# claude_sonnet_capacity   = 10
# claude_organization_name = "replace-with-legal-entity-name"
# claude_country_code      = "US"
# claude_industry          = "technology"

# ─── Optional direct-provider compatibility ──────────────────────────────────
#
# The Azure deployment does not require this key. Leave it blank to keep all
# production model inference on the managed-identity gateway. It exists only
# for deployments that deliberately retain a separate direct-provider path.
# Pass it on the CLI to keep it off disk:
#   terraform apply -var "openai_api_key=$OPENAI_API_KEY"

# openai_api_key = ""
